{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-product-md.sh\"",
            "timeout": 10,
            "statusMessage": "Checking PRODUCT.md guard"
          }
        ]
      }
    ]
  }
}
